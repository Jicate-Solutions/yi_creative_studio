/**
 * Super Admin API: Regenerate Webhook Secret
 * POST /api/super-admin/webhooks/sources/[id]/regenerate-secret
 *
 * Generates a new webhook secret for an event source
 */

import { NextRequest, NextResponse } from 'next/server'
import { superAdminGuard } from '@/lib/middleware/super-admin-guard'
import { logSuperAdminAction } from '@/lib/services/audit-service'
import crypto from 'crypto'

export async function POST(request: NextRequest, { params }: { params: Promise<{ id: string }> }) {
  const { id } = await params

  return superAdminGuard(request, async (req, { adminClient, superAdmin }) => {
    try {
      // Using 'as any' because event_sources table is not yet in database types
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const client = adminClient as any

      // Fetch existing source
      const { data: existingSource, error: fetchError } = await client
        .from('event_sources')
        .select('*')
        .eq('id', id)
        .single()

      if (fetchError || !existingSource) {
        return NextResponse.json({ error: 'Event source not found' }, { status: 404 })
      }

      // Generate new webhook secret
      const newWebhookSecret = crypto.randomBytes(32).toString('hex')

      // Update event source with new secret
      const { data: updatedSource, error: updateError } = await client
        .from('event_sources')
        .update({
          webhook_secret: newWebhookSecret,
          updated_at: new Date().toISOString(),
        })
        .eq('id', id)
        .select()
        .single()

      if (updateError) {
        console.error('[super-admin] Failed to regenerate webhook secret:', updateError)
        return NextResponse.json(
          { error: 'Failed to regenerate webhook secret', details: updateError.message },
          { status: 500 }
        )
      }

      // Log the action (don't log the actual secrets for security)
      await logSuperAdminAction({
        super_admin_id: superAdmin.id,
        action: 'webhook:source:regenerate_secret',
        resource_type: 'event_source',
        resource_id: id,
        target_organization_id: existingSource.organization_id,
        changes: {
          before: { webhook_secret: '[REDACTED]' },
          after: { webhook_secret: '[REGENERATED]' },
        },
      })

      return NextResponse.json({
        success: true,
        source: {
          ...updatedSource,
          // Return full secret only on regeneration
          webhook_secret: newWebhookSecret,
        },
        message: 'Webhook secret regenerated successfully. Save the new secret - it will not be shown again.',
      })
    } catch (error) {
      console.error('[super-admin] Exception regenerating webhook secret:', error)
      return NextResponse.json(
        { error: 'Internal server error', details: error instanceof Error ? error.message : 'Unknown error' },
        { status: 500 }
      )
    }
  })
}
