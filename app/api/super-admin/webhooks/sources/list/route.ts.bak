/**
 * Super Admin API: List Event Sources
 * GET /api/super-admin/webhooks/sources/list
 *
 * Returns paginated list of event sources with organization data
 */

import { NextRequest, NextResponse } from 'next/server'
import { superAdminGuard } from '@/lib/middleware/super-admin-guard'

export async function GET(request: NextRequest) {
  return superAdminGuard(request, async (req, { adminClient }) => {
    const { searchParams } = new URL(req.url)

    // Query parameters
    const page = parseInt(searchParams.get('page') || '1')
    const pageSize = parseInt(searchParams.get('pageSize') || '25')
    const search = searchParams.get('search') || ''
    const status = searchParams.get('status') // 'active', 'inactive', or null for all
    const organizationId = searchParams.get('organization_id')

    const offset = (page - 1) * pageSize

    try {
      // Build query - Using 'as any' because event_sources table is not yet in database types
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      let query = (adminClient as any)
        .from('event_sources')
        .select(
          `
          *,
          organization:organizations(id, name)
        `,
          { count: 'exact' }
        )

      // Search filter
      if (search) {
        query = query.or(`name.ilike.%${search}%,source_app_id.ilike.%${search}%`)
      }

      // Status filter
      if (status === 'active') {
        query = query.eq('is_active', true)
      } else if (status === 'inactive') {
        query = query.eq('is_active', false)
      }

      // Organization filter
      if (organizationId) {
        query = query.eq('organization_id', organizationId)
      }

      // Sorting and pagination
      query = query.order('created_at', { ascending: false }).range(offset, offset + pageSize - 1)

      const { data: sources, error, count } = await query

      if (error) {
        console.error('[super-admin] Failed to fetch event sources:', error)
        return NextResponse.json({ error: 'Failed to fetch event sources', details: error.message }, { status: 500 })
      }

      // Mask webhook secrets (show first 8 chars only)
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const maskedSources = sources?.map((source: any) => ({
        ...source,
        webhook_secret: source.webhook_secret ? `${source.webhook_secret.substring(0, 8)}${'*'.repeat(24)}` : null,
        webhook_secret_preview: source.webhook_secret ? source.webhook_secret.substring(0, 8) : null,
      }))

      return NextResponse.json({
        success: true,
        sources: maskedSources || [],
        pagination: {
          page,
          pageSize,
          total: count || 0,
          totalPages: Math.ceil((count || 0) / pageSize),
        },
      })
    } catch (error) {
      console.error('[super-admin] Exception fetching event sources:', error)
      return NextResponse.json(
        { error: 'Internal server error', details: error instanceof Error ? error.message : 'Unknown error' },
        { status: 500 }
      )
    }
  })
}
